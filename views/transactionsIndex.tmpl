{{define "transactionsIndex"}}
<h2>Transactions</h2>
<table border="1">
    <tr>
        <th>ID</th>
        <th>Account ID</th>
        <th>Description</th>
        <th>Amount</th>
    </tr>
    {{range .Transactions}}
    <tr>
        <td>{{.ID}}</td>
        <td>{{.AccountID}}</td>
        <td>{{.Description}}</td>
        <td>{{printf "%.2f" .Amount}}</td>
    </tr>
    {{else}}
    <tr><td colspan="4">No transactions</td></tr>
    {{end}}
</table>
{{end}}