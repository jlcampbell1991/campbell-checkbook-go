{{define "pay_days_index.tmpl"}}
<h2>Pay Days</h2>
<a href="/pay-days/new">New Pay Day</a>
<table>
<tr><th>Name</th><th>Total</th><th>Account</th><th>Actions</th></tr>
{{range .PayDays}}
<tr>
<td>{{.Name}}</td>
<td>{{.Total}}</td>
<td>{{.AccountId}}</td>
<td><a href="/pay-days/{{.Id.Value}}">View</a> | <a href="/pay-days/{{.Id.Value}}/edit">Edit</a></td>
</tr>
{{end}}
</table>
{{end}}