{{define "account_items_layout"}}
<table style="min-width: 100px;">
  <thead>
    <tr>
      <th>Item</th><th>Budget</th><th>Balance</th>
    </tr>
  </thead>
  <tbody>
    {{range .LineItems}}
    <tr class='line-items'>
      <td><a href="/line-items/{{.ID}}">{{.Name}}</a></td>
      <td class="currency {{IsWithdrawal (Value .Budget)}}">{{Format (Value .Budget)}}</td>
      <td class="currency {{IsWithdrawal (Value .Balance)}}">{{Format (Value .Balance)}}</td>
      <td><a href="/accounts/{{.AccountID}}/line-items/{{.ID}}/transactions/new">Add Trans</a></td>
      <td><a href="/transfers/new?line-item-id={{.ID}}">Transfer</a></td>
    </tr>
    {{end}}
    <tr>
      <td><strong>Total</strong></td>
      <td><strong>0.00</strong></td>
      <td><strong>0.00</strong></td>
    </tr>
  </tbody>
</table>
{{end}}
