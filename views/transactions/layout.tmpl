{{define "transactions_layout.tmpl"}}
<table>
    <tr><th>Date</th><th>Category</th><th>Amount</th></tr>
    {{range .Transactions}}
    <tr>
        <td>{{.Date}}</td>
        <td>{{.Category}}</td>
        <td class="{{if IsWithdrawal .Amount}}withdrawal{{else}}deposit{{end}}">{{CurrencyFromDouble .Amount}}</td>
    </tr>
    {{end}}
</table>
<a href="{{.NextURL}}">Next</a>
{{end}}