{{define "transactions_edit.tmpl"}}
{{template "application.tmpl" .}}
{{define "content"}}
<h2>Edit Transaction</h2>
<form method="POST" action="/transactions/{{.ID}}/edit">
    <label>Date: <input type="date" name="date" value="{{.Date.Format \"2006-01-02\"}}" required></label><br>
    <label>Memo: <input type="text" name="memo" value="{{.Memo}}" required></label><br>
    <label>Amount: <input type="number" step="0.01" name="amount" value="{{.Amount}}" required></label><br>
    <label>Category: <input type="text" name="category" value="{{.Category}}"></label><br>
    <input type="hidden" name="account_id" value="{{.AccountID}}">
    <input type="hidden" name="line_item_id" value="{{.LineItemID}}">
    <button type="submit">Update</button>
</form>
{{end}}
{{end}}
