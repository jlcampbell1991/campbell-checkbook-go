{{define "transactions_csv_form.tmpl"}}
{{template "application.tmpl" .}}
{{define "content"}}
<h2>Upload Transactions CSV</h2>
<form method="POST" action="/transactions/upload-csv" enctype="multipart/form-data">
    <textarea name="csv" rows="10" cols="80" placeholder="Paste CSV content here"></textarea><br>
    <button type="submit">Upload</button>
</form>
{{end}}
{{end}}